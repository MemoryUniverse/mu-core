# import-linter — the intra-mu-core boundary (PACKAGING-v2 §5.2), CI gate.
# The load-bearing contracts for THIS repo: core-layers + mu-local-layers.
# Cross-plane gates (mu-client / mu-server never touch each other) live in those
# repos' own CI as grep gates (§5.3) — they cannot be resolved from here.

[importlinter]
root_packages =
    mu_contracts
    mu_engine
    mu_local
    mu_engine_server
# Required so contract-level `forbidden_modules` naming mu_server/mu_client (external — those
# live in separate repos, not in this workspace) is still checked, not silently skipped
# (mu-engine-server-boundary below).
include_external_packages = True

# contracts is the base; engine sits above and may not be imported downward-in.
[importlinter:contract:core-layers]
name = core-layers (contracts <- engine)
type = layers
layers =
    mu_engine
    mu_contracts

# mu-local (embedded engine) sits above engine + contracts.
[importlinter:contract:mu-local-layers]
name = mu-local-layers (contracts <- engine <- local)
type = layers
layers =
    mu_local
    mu_engine
    mu_contracts

# contracts is pydantic-only: it must never reach up into engine or local.
[importlinter:contract:contracts-imports-nothing-in-project]
name = contracts imports nothing in-project
type = forbidden
source_modules =
    mu_contracts
forbidden_modules =
    mu_engine
    mu_local

# mu-engine-server (design 2026-07-31-sdk-engine-server-design.md §2.2/§8, build-plan §4 C0):
# thin single-tenant HTTP server over {mu_contracts, mu_engine} ONLY. Routes bind SurfaceFacade
# (mu-engine), never LocalMemory (mu-local) — so mu_local is forbidden here too, not just
# mu_server/mu_client (mu_server is COMMERCIAL/multi-tenant, mu_client is the on-device capture
# daemon; neither lives in this repo, both named per the design's forbidden-modules list, §8).
[importlinter:contract:mu-engine-server-boundary]
name = mu-engine-server-boundary (contracts + engine only, never local/server/client)
type = forbidden
source_modules =
    mu_engine_server
forbidden_modules =
    mu_server
    mu_client
    mu_local

# persona (persona-design.md §0 / §2.4 line 122): the persona subsystem is SLEEP-TIME. Nothing
# that runs while a user is waiting may import it — the CI twin of
# packages/mu-engine/tests/services/persona/test_persona_boundary_unit.py, which scans both root
# packages statically. Kept as an explicit source list rather than "all of mu_engine" because the
# composition roots (platform/composition.py, mu_local/composition.py) are exactly the modules
# whose job IS to name every subsystem. Chains are reported transitively, so a leak that hides one
# import deep still fails.
[importlinter:contract:persona-off-the-hot-path]
name = persona-off-the-hot-path (sleep-time only, never recall/ingest/warm)
type = forbidden
source_modules =
    mu_engine.services.recall
    mu_engine.services.ingest
    mu_engine.services.extract
    mu_engine.services.conflict
    mu_engine.surface
    mu_engine.storage
    mu_engine.pipelines
    mu_engine.lifecycle
    mu_engine.providers
    mu_local.local_memory
forbidden_modules =
    mu_engine.services.persona
