# Test Settings profile — read by mu_contracts.config.Settings (env_file).
# Wires the host-facing ports of the docker-compose.dev.yml mu-dev-* stores.
# NOT hardcoded in code: ports live here and flow through the central Settings tree.
# Dev-only throwaway credentials for local disposable containers (no real secrets).

MU_RUNTIME_MODE=local

# mu-dev-postgres  (postgres:16-alpine)  host 15432 -> container 5432
MU_STORAGE__POSTGRES__HOST=localhost
MU_STORAGE__POSTGRES__PORT=15432
MU_STORAGE__POSTGRES__USER=mu
MU_STORAGE__POSTGRES__PASSWORD=mu_dev_pw
MU_STORAGE__POSTGRES__DATABASE=mu

# mu-dev-cache  (valkey/valkey:8-alpine)  host 16379 -> container 6379
MU_STORAGE__CACHE__HOST=localhost
MU_STORAGE__CACHE__PORT=16379
MU_STORAGE__CACHE__DB=0

# (kv, "valkey") registry key — same real mu-dev-cache container, registered explicitly
# (storage-pluggable-spec.md §3.2; owner stage 2026-07-27).
MU_STORAGE__VALKEY__HOST=localhost
MU_STORAGE__VALKEY__PORT=16379
MU_STORAGE__VALKEY__DB=0

# mu-dev-memcached  (memcached:1.6-alpine)  host 11211 -> container 11211
MU_STORAGE__MEMCACHED__HOST=localhost
MU_STORAGE__MEMCACHED__PORT=11211
MU_STORAGE__MEMCACHED__RECENCY_CAP=500

# mu-dev-mysql  (mysql:8)  host 13306 -> container 3306
MU_STORAGE__MYSQL__HOST=localhost
MU_STORAGE__MYSQL__PORT=13306
MU_STORAGE__MYSQL__USER=mu
MU_STORAGE__MYSQL__PASSWORD=mu_dev_pw
MU_STORAGE__MYSQL__DATABASE=mu

# mu-dev-qdrant  (qdrant/qdrant:v1.12.5)  host 16333/16334 -> container 6333/6334
MU_STORAGE__VECTOR__HOST=localhost
MU_STORAGE__VECTOR__HTTP_PORT=16333
MU_STORAGE__VECTOR__GRPC_PORT=16334

# mu-dev-falkordb  (falkordb/falkordb:v4.20.1)  host 16380 -> container 6379
MU_STORAGE__GRAPH__HOST=localhost
MU_STORAGE__GRAPH__PORT=16380
MU_STORAGE__GRAPH__GRAPH_NAME=mu

# mu-dev-pgvector  (pgvector/pgvector:pg16, `vector` extension pre-created)  host 15433 -> container 5432
# alternate MTM vector backend (storage-pluggable-spec.md §3.3) — separate Postgres endpoint from
# MU_STORAGE__POSTGRES__* (the control-plane store above).
MU_STORAGE__PGVECTOR__HOST=localhost
MU_STORAGE__PGVECTOR__PORT=15433
MU_STORAGE__PGVECTOR__USER=mu
MU_STORAGE__PGVECTOR__PASSWORD=mu
MU_STORAGE__PGVECTOR__DATABASE=mu

# chroma — embedded MTM floor (on-disk, no container). Test runs use a throwaway scratch dir.
MU_STORAGE__CHROMA__PATH=.mu_data/test_chroma

# faiss — in-proc MTM floor, PRIVATE-plane only (D3; no container).
MU_STORAGE__FAISS__PATH=.mu_data/test_faiss
