# Test Settings profile — read by mu_contracts.config.Settings (env_file).
# Wires the host-facing ports of the docker-compose.dev.yml mu-dev-* stores.
# NOT hardcoded in code: ports live here and flow through the central Settings tree.
# Dev-only throwaway credentials for local disposable containers (no real secrets).

MU_RUNTIME_MODE=local

# mu-dev-postgres  (postgres:16-alpine)  host 15432 -> container 5432
MU_STORAGE__POSTGRES__HOST=localhost
MU_STORAGE__POSTGRES__PORT=15432
MU_STORAGE__POSTGRES__USER=mu
MU_STORAGE__POSTGRES__PASSWORD=mu_dev_pw
MU_STORAGE__POSTGRES__DATABASE=mu

# mu-dev-cache  (redis:7-alpine, stands in for Valkey)  host 16379 -> container 6379
MU_STORAGE__CACHE__HOST=localhost
MU_STORAGE__CACHE__PORT=16379
MU_STORAGE__CACHE__DB=0

# mu-dev-qdrant  (qdrant/qdrant:v1.12.5)  host 16333/16334 -> container 6333/6334
MU_STORAGE__VECTOR__HOST=localhost
MU_STORAGE__VECTOR__HTTP_PORT=16333
MU_STORAGE__VECTOR__GRPC_PORT=16334

# mu-dev-falkordb  (falkordb/falkordb:v4.20.1)  host 16380 -> container 6379
MU_STORAGE__GRAPH__HOST=localhost
MU_STORAGE__GRAPH__PORT=16380
MU_STORAGE__GRAPH__GRAPH_NAME=mu
